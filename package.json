{
  "name": "nse-option-chain",
  "version": "1.0.0",
  "description": "Real-time NSE Option Chain web dashboard and Excel exporter in pure Node.js",
  "type": "module",
  "scripts": {
    "start": "node --dns-result-order=ipv4first nodejs/nseOptionChain.mjs --symbol NIFTY",
    "sensex": "node --dns-result-order=ipv4first nodejs/nseOptionChain.mjs --symbol SENSEX",
    "banknifty": "node --dns-result-order=ipv4first nodejs/nseOptionChain.mjs --symbol BANKNIFTY"
  }
}
